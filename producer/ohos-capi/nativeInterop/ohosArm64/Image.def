package = platform.ImageKit.Image
headers = multimedia/image_framework/image_source_mdk.h multimedia/image_framework/image_mdk.h multimedia/image_framework/image_receiver_mdk.h multimedia/image_framework/image_pixel_map_mdk.h multimedia/image_framework/image_mdk_common.h multimedia/image_framework/image_packer_mdk.h
headerFilter = multimedia/image_framework/**
