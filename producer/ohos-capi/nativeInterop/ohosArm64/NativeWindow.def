package = platform.ArkGraphics2D.NativeWindow
headers = native_image/graphic_error_code.h native_vsync/graphic_error_code.h native_buffer/graphic_error_code.h native_window/buffer_handle.h native_window/external_window.h native_window/graphic_error_code.h
