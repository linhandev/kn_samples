package = platform.AudioKit.OHAudio
headers = ohaudio/native_audiostream_base.h ohaudio/native_audio_session_manager.h ohaudio/native_audio_stream_manager.h ohaudio/native_audio_volume_manager.h ohaudio/native_audio_manager.h ohaudio/native_audiorenderer.h ohaudio/native_audio_resource_manager.h ohaudio/native_audio_routing_manager.h ohaudio/native_audio_common.h ohaudio/native_audio_device_base.h ohaudio/native_audiostreambuilder.h ohaudio/native_audiocapturer.h
headerFilter = ohaudio/**
depends = posix Core 
linkerOpts = -lohaudio
language = C++
compilerOpts = -std=c++17
enableUndefinedApiProtection = true
