package = platform.ArkUI.WindowManager
headers = cstddef window_manager/oh_window.h window_manager/oh_window_comm.h window_manager/oh_window_event_filter.h window_manager/oh_window_pip.h
headerFilter = window_manager/**
depends = Input
linkerOpts = -lnative_window_manager
language = C++
compilerOpts = -std=c++17
enableUndefinedApiProtection = true
